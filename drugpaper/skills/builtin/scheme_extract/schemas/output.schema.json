{
  "$defs": {
    "PositionPolicy": {
      "additionalProperties": false,
      "properties": {
        "requirement": {
          "default": "unknown",
          "enum": [
            "required",
            "optional",
            "not_applicable",
            "unknown",
            "exhausted"
          ],
          "title": "Requirement",
          "type": "string"
        },
        "scope": {
          "default": "per_member",
          "enum": [
            "per_member",
            "endpoint"
          ],
          "title": "Scope",
          "type": "string"
        },
        "source": {
          "default": "none",
          "enum": [
            "printed_column",
            "printed_prefix",
            "cross_reference",
            "none"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_ref": {
          "default": "",
          "title": "Source Ref",
          "type": "string"
        },
        "basis": {
          "default": "",
          "title": "Basis",
          "type": "string"
        },
        "evidence_text": {
          "default": "",
          "title": "Evidence Text",
          "type": "string"
        }
      },
      "title": "PositionPolicy",
      "type": "object"
    },
    "CompoundInstance": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "mol_id": {
              "type": "integer"
            },
            "scaffold_mol_id": {
              "type": "null"
            },
            "substituents": {
              "maxProperties": 0
            }
          },
          "required": [
            "mol_id"
          ]
        },
        {
          "properties": {
            "mol_id": {
              "type": "null"
            },
            "scaffold_mol_id": {
              "type": "integer"
            },
            "substituents": {
              "minProperties": 1
            }
          },
          "required": [
            "scaffold_mol_id",
            "substituents"
          ]
        }
      ],
      "properties": {
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "mol_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mol Id"
        },
        "scaffold_mol_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scaffold Mol Id"
        },
        "substituents": {
          "description": "Group/atom identities keyed by image-derived variables or local groups. Strings are source-supported local abbreviations; integers are current-image detected group IDs. Position-only numbers or locants belong in position_definitions, never here.",
          "additionalProperties": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Substituents",
          "type": "object"
        },
        "attachments": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Complete local assignment keys in substituents selected for later assembly; other keys are explanatory. A position column for an existing scaffold group does not create an attachment. Recognition-label mapping is checked later. None is for legacy records only; new scaffold instances must supply this list.",
          "title": "Attachments",
          "uniqueItems": true
        },
        "position_definitions": {
          "description": "Source group/site to explicit location, e.g. CHO=4 or XCHYZ=2′. Preserve locant primes exactly. Keys may name existing scaffold groups absent from substituents and attachments. Source prose belongs in evidence_text.",
          "additionalProperties": {
            "type": "string"
          },
          "title": "Position Definitions",
          "type": "object"
        },
        "position_status": {
          "anyOf": [
            {
              "enum": [
                "provided",
                "not_printed",
                "unreadable",
                "missing",
                "not_applicable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provide when the endpoint declares a position policy: provided/not_printed/unreadable/missing/not_applicable. None is legacy only.",
          "title": "Position Status"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "evidence_text": {
          "minLength": 1,
          "title": "Evidence Text",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "evidence_text"
      ],
      "title": "CompoundInstance",
      "type": "object"
    },
    "CompoundSeries": {
      "additionalProperties": false,
      "properties": {
        "members": {
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "member_count": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Member Count",
          "type": "integer"
        },
        "variable_definitions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Variable Definitions",
          "type": "object"
        },
        "structure_status": {
          "default": "unresolved",
          "enum": [
            "unresolved",
            "partial",
            "resolved"
          ],
          "title": "Structure Status",
          "type": "string"
        },
        "unresolved_reason": {
          "default": "",
          "title": "Unresolved Reason",
          "type": "string"
        },
        "evidence_text": {
          "minLength": 1,
          "title": "Evidence Text",
          "type": "string"
        }
      },
      "required": [
        "members",
        "member_count",
        "evidence_text"
      ],
      "title": "CompoundSeries",
      "type": "object"
    },
    "ExtractionGap": {
      "additionalProperties": false,
      "description": "Skill-reported evidence needs, independent of paper labels and chart type.",
      "properties": {
        "gap_id": {
          "description": "Stable ID; host adds the skill: namespace",
          "maxLength": 74,
          "minLength": 1,
          "title": "Gap Id",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "field_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Field Paths",
          "type": "array"
        },
        "category": {
          "enum": [
            "missing_evidence",
            "conflicting_evidence",
            "unsupported_representation"
          ],
          "title": "Category",
          "type": "string"
        },
        "next_action": {
          "enum": [
            "search_text",
            "inspect_visual",
            "review_structure",
            "manual_review"
          ],
          "title": "Next Action",
          "type": "string"
        },
        "query_terms": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Query Terms",
          "type": "array"
        },
        "source_hints": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Source Hints",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "gap_id",
        "question",
        "field_paths",
        "category",
        "next_action"
      ],
      "title": "ExtractionGap",
      "type": "object"
    },
    "MarkushExplanation": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "variable_options": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "minProperties": 1,
          "title": "Variable Options",
          "type": "object"
        },
        "substitution_cases": {
          "items": {
            "$ref": "#/$defs/MarkushSubstitutionCase"
          },
          "maxItems": 128,
          "title": "Substitution Cases",
          "type": "array"
        },
        "expansion_status": {
          "enum": [
            "not_expanded",
            "complete_for_visible_options",
            "partial",
            "unclear"
          ],
          "title": "Expansion Status",
          "type": "string"
        },
        "notes": {
          "minLength": 1,
          "title": "Notes",
          "type": "string"
        },
        "evidence_text": {
          "minLength": 1,
          "title": "Evidence Text",
          "type": "string"
        }
      },
      "required": [
        "description",
        "variable_options",
        "expansion_status",
        "notes",
        "evidence_text"
      ],
      "title": "MarkushExplanation",
      "type": "object"
    },
    "MarkushSubstitutionCase": {
      "additionalProperties": false,
      "description": "One local substituent possibility, not an instantiated paper compound.",
      "properties": {
        "expression": {
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "group_text": {
          "minLength": 1,
          "title": "Group Text",
          "type": "string"
        },
        "assignments": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Assignments",
          "type": "array"
        },
        "basis": {
          "default": "symbolic_substitution",
          "enum": [
            "printed",
            "symbolic_substitution"
          ],
          "title": "Basis",
          "type": "string"
        },
        "evidence_text": {
          "minLength": 1,
          "title": "Evidence Text",
          "type": "string"
        }
      },
      "required": [
        "expression",
        "group_text",
        "assignments",
        "evidence_text"
      ],
      "title": "MarkushSubstitutionCase",
      "type": "object"
    },
    "MoleculeReference": {
      "properties": {
        "markush": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarkushExplanation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "compound_series": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompoundSeries"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scaffold_mol_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scaffold Mol Id"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/CompoundInstance"
          },
          "title": "Variants",
          "type": "array"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "common_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Common Name"
        },
        "mol_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mol Id"
        },
        "substituents": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Substituents",
          "type": "object"
        },
        "evidence_text": {
          "default": "",
          "title": "Evidence Text",
          "type": "string"
        },
        "status": {
          "default": "explicit",
          "title": "Status",
          "type": "string"
        },
        "position_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositionPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether this endpoint/series needs per-member locants and where they come from.",
          "title": "Position Policy"
        }
      },
      "title": "MoleculeReference",
      "type": "object"
    },
    "ReactionPathway": {
      "additionalProperties": true,
      "properties": {
        "base_info": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoleculeReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/ReactionTransformation"
          },
          "title": "Steps",
          "type": "array"
        },
        "optimization_steps": {
          "items": {
            "$ref": "#/$defs/ReactionStep"
          },
          "title": "Optimization Steps",
          "type": "array"
        }
      },
      "title": "ReactionPathway",
      "type": "object"
    },
    "ReactionStep": {
      "additionalProperties": true,
      "properties": {
        "markush": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarkushExplanation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "compound_series": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompoundSeries"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scaffold_mol_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scaffold Mol Id"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/CompoundInstance"
          },
          "title": "Variants",
          "type": "array"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "common_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Common Name"
        },
        "mol_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mol Id"
        },
        "substituents": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Substituents",
          "type": "object"
        },
        "evidence_text": {
          "default": "",
          "title": "Evidence Text",
          "type": "string"
        },
        "status": {
          "default": "explicit",
          "title": "Status",
          "type": "string"
        },
        "position_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositionPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether this endpoint/series needs per-member locants and where they come from.",
          "title": "Position Policy"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "extra": {
          "items": {
            "$ref": "#/$defs/MoleculeReference"
          },
          "title": "Extra",
          "type": "array"
        }
      },
      "title": "ReactionStep",
      "type": "object"
    },
    "ReactionTransformation": {
      "additionalProperties": true,
      "properties": {
        "relationship_type": {
          "default": "reaction",
          "enum": [
            "reaction",
            "optimization",
            "selection",
            "unresolved"
          ],
          "title": "Relationship Type",
          "type": "string"
        },
        "evidence_text": {
          "default": "",
          "title": "Evidence Text",
          "type": "string"
        },
        "reactants": {
          "items": {
            "$ref": "#/$defs/MoleculeReference"
          },
          "title": "Reactants",
          "type": "array"
        },
        "products": {
          "items": {
            "$ref": "#/$defs/MoleculeReference"
          },
          "title": "Products",
          "type": "array"
        },
        "conditions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditions"
        },
        "variant_links": {
          "items": {
            "$ref": "#/$defs/VariantLink"
          },
          "title": "Variant Links",
          "type": "array"
        }
      },
      "title": "ReactionTransformation",
      "type": "object"
    },
    "VariantLink": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "evidence_text": {
          "minLength": 1,
          "title": "Evidence Text",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "evidence_text"
      ],
      "title": "VariantLink",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "compound_instances": {
      "items": {
        "$ref": "#/$defs/CompoundInstance"
      },
      "title": "Compound Instances",
      "type": "array"
    },
    "molecule_inventory": {
      "items": {
        "type": "object"
      },
      "title": "Molecule Inventory",
      "type": "array"
    },
    "status": {
      "default": "ok",
      "enum": [
        "ok",
        "unclear"
      ],
      "title": "Status",
      "type": "string"
    },
    "evidence_text": {
      "default": "",
      "title": "Evidence Text",
      "type": "string"
    },
    "molecules": {
      "items": {
        "$ref": "#/$defs/MoleculeReference"
      },
      "title": "Molecules",
      "type": "array"
    },
    "base_info": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoleculeReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "optimization_steps": {
      "items": {
        "$ref": "#/$defs/ReactionStep"
      },
      "title": "Optimization Steps",
      "type": "array"
    },
    "pathways": {
      "items": {
        "$ref": "#/$defs/ReactionPathway"
      },
      "title": "Pathways",
      "type": "array"
    },
    "key_findings": {
      "items": {
        "type": "string"
      },
      "title": "Key Findings",
      "type": "array"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "information_gaps": {
      "items": {
        "$ref": "#/$defs/ExtractionGap"
      },
      "maxItems": 24,
      "title": "Information Gaps",
      "type": "array"
    }
  },
  "title": "VisualExtraction",
  "type": "object"
}
