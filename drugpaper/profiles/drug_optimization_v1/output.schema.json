          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "SMILES",
        "存在问题"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "object",
      "patternProperties": {
        "^[1-9][0-9]*$": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "minLength": 1
            },
            "change": {
              "type": "string",
              "minLength": 1
            },
            "smiles_change": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "原始片段": {
                    "type": "string",
                    "minLength": 1
                  },
                  "替代片段": {
                    "type": "string",
                    "minLength": 1
                  },
                  "说明": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "原始片段",
                  "替代片段",
                  "说明"
                ],
                "additionalProperties": false
              }
            },
            "end": {
              "type": "object",
              "properties": {
                "smiles": {
                  "type": "string",
                  "minLength": 1
                },
                "extra": {
                  "type": "object",
                  "properties": {
                    "scaffold": {
                      "type": "string",
                      "minLength": 1
                    },
                    "substituent": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "scaffold",
                    "substituent"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "smiles",
                "extra"
              ],
              "additionalProperties": false
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "flag": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "start",
            "change",
            "smiles_change",
            "end",
            "description",
            "flag"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "优化策略": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "策略类型": {
            "type": "string",
            "minLength": 1
          },
          "具体操作": {
            "type": "string",
            "minLength": 1
