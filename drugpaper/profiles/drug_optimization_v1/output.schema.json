  "properties": {
    "基本信息": {
      "type": "object",
      "properties": {
        "论文题目": {
          "type": "string",
          "minLength": 1
        },
        "论文作者": {
          "type": "string",
          "minLength": 1
        },
        "论文研究内容以及主要贡献": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "论文题目",
        "论文作者",
        "论文研究内容以及主要贡献"
      ],
      "additionalProperties": false
    },
    "成药性优化方向标签": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "先导化合物分子信息": {
      "type": "object",
      "properties": {
        "SMILES": {
          "type": "string",
          "minLength": 1
