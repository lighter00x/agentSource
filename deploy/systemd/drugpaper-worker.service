[Unit]
Description=Drugpaper figure agents Celery worker
Wants=drugpaper-detector.service
After=network-online.target drugpaper-detector.service

[Service]
Type=simple
WorkingDirectory=/home/xq/source/agent_source
EnvironmentFile=/home/xq/source/agent_source/deploy/runtime.env
Environment=YOLO_BACKEND=remote
ExecStart=/home/xq/source/agent_source/.venv/bin/celery -A drugpaper.workers.celery_app:app worker --queues=batch,interactive --concurrency=2 --loglevel=INFO
Restart=on-failure
RestartSec=5
TimeoutStopSec=240
KillSignal=SIGTERM
UMask=0077

[Install]
WantedBy=default.target
