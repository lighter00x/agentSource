[Unit]
Description=Drugpaper workbench API
Wants=drugpaper-detector.service
After=network-online.target drugpaper-detector.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/xq/source/agent_source
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
Environment=http_proxy=
Environment=https_proxy=
Environment=all_proxy=
Environment=NO_PROXY=*
ExecStart=/home/xq/source/agent_source/.venv/bin/python -m scripts.dev_workbench --port 18001 --data-dir /home/xq/source/agent_source/data/workbench-dev --connected
Restart=always
RestartSec=5
TimeoutStopSec=150
KillSignal=SIGTERM
UMask=0077

[Install]
WantedBy=default.target
