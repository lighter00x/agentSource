{
  "$defs": {
    "BBox": {
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BBox",
      "type": "object"
    },
    "CompoundNote": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "role_hint": {
          "default": "unknown",
          "enum": [
            "hit",
            "lead",
            "final",
            "analog",
            "reference",
            "unknown"
          ],
          "title": "Role Hint",
          "type": "string"
        },
        "first_page": {
          "title": "First Page",
          "type": "integer"
        },
        "key_points": {
          "items": {
            "type": "string"
          },
          "title": "Key Points",
          "type": "array"
        },
        "evidence_nodes": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Nodes",
          "type": "array"
        },
        "unconfirmed": {
          "default": false,
          "title": "Unconfirmed",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "first_page"
      ],
      "title": "CompoundNote",
      "type": "object"
    },
    "EvidenceRef": {
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        },
        "char_span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Span"
        },
        "regions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Region"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regions"
        },
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "role": {
          "default": "primary",
          "enum": [
            "primary",
            "context",
            "definition",
            "condition",
            "contradiction"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "node_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "LookupQuestion": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "kind": {
          "default": "text",
          "enum": [
            "text",
            "vision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target_page": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Page"
        },
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        }
      },
      "required": [
        "question"
      ],
      "title": "LookupQuestion",
      "type": "object"
    },
    "LookupResult": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "default": "",
          "maxLength": 150,
          "title": "Answer",
          "type": "string"
        },
        "status": {
          "default": "not_found",
          "enum": [
            "found",
            "not_found",
            "ambiguous",
            "need_vision"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "suggested_pages": {
          "items": {
            "type": "integer"
          },
          "title": "Suggested Pages",
          "type": "array"
        },
        "lookup_run_id": {
          "default": "",
          "title": "Lookup Run Id",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "title": "LookupResult",
      "type": "object"
    },
    "NarrativeEvent": {
      "additionalProperties": false,
      "properties": {
        "from_label": {
          "title": "From Label",
          "type": "string"
        },
        "to_label": {
          "title": "To Label",
          "type": "string"
        },
        "change": {
          "title": "Change",
          "type": "string"
        },
        "motivation": {
          "default": "",
          "title": "Motivation",
          "type": "string"
        },
        "outcome": {
          "default": "",
          "title": "Outcome",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "evidence_nodes": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Nodes",
          "type": "array"
        },
        "unconfirmed": {
          "default": false,
          "title": "Unconfirmed",
          "type": "boolean"
        }
      },
      "required": [
        "from_label",
        "to_label",
        "change",
        "page"
      ],
      "title": "NarrativeEvent",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "evidence_nodes": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Nodes",
          "type": "array"
        }
      },
      "required": [
        "text",
        "page"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Region": {
      "properties": {
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "source_bbox_pt": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Bbox Pt"
        },
        "role": {
          "default": "primary",
          "enum": [
            "primary",
            "continuation",
            "segment"
          ],
          "title": "Role",
          "type": "string"
        },
        "derived": {
          "default": false,
          "title": "Derived",
          "type": "boolean"
        }
      },
      "required": [
        "page",
        "bbox"
      ],
      "title": "Region",
      "type": "object"
    }
  },
  "properties": {
    "thesis": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Thesis",
      "type": "array"
    },
    "compounds": {
      "items": {
        "$ref": "#/$defs/CompoundNote"
      },
      "title": "Compounds",
      "type": "array"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/NarrativeEvent"
      },
      "title": "Timeline",
      "type": "array"
    },
    "sar": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Sar",
      "type": "array"
    },
    "lead_problems": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Lead Problems",
      "type": "array"
    },
    "open_questions": {
      "items": {
        "$ref": "#/$defs/LookupQuestion"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "lookup_answers": {
      "items": {
        "$ref": "#/$defs/LookupResult"
      },
      "title": "Lookup Answers",
      "type": "array"
    },
    "pointers": {
      "additionalProperties": {
        "items": {
          "type": "integer"
        },
        "type": "array"
      },
      "title": "Pointers",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "pages_read": {
      "items": {
        "type": "integer"
      },
      "title": "Pages Read",
      "type": "array"
    },
    "model_calls": {
      "default": 0,
      "title": "Model Calls",
      "type": "integer"
    },
    "tool_calls": {
      "default": 0,
      "title": "Tool Calls",
      "type": "integer"
    },
    "model_records": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Model Records",
      "type": "array"
    }
  },
  "title": "ReaderNotes",
  "type": "object"
}
