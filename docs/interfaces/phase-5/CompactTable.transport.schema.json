{
  "$defs": {
    "CompoundInstance": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "mol_id": {
              "type": "integer"
            },
            "scaffold_mol_id": {
              "type": "null"
            },
            "substituents": {
              "maxProperties": 0
            }
          },
          "required": [
            "mol_id"
          ]
        },
        {
          "properties": {
            "mol_id": {
              "type": "null"
            },
            "scaffold_mol_id": {
              "type": "integer"
            },
            "substituents": {
              "minProperties": 1
            }
          },
          "required": [
            "scaffold_mol_id",
            "substituents"
          ]
        }
      ],
      "properties": {
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "mol_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mol Id"
        },
        "scaffold_mol_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scaffold Mol Id"
        },
        "substituents": {
          "additionalProperties": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Substituents",
          "type": "object"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "evidence_text": {
          "minLength": 1,
          "title": "Evidence Text",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "evidence_text"
      ],
      "title": "CompoundInstance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Wire schema: ordinary cells are strings, sparse annotations carry metadata.",
  "properties": {
    "compound_instances": {
      "items": {
        "$ref": "#/$defs/CompoundInstance"
      },
      "title": "Compound Instances",
      "type": "array"
    },
    "molecules": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Molecules",
      "type": "array"
    },
    "molecule_inventory": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Molecule Inventory",
      "type": "array"
    },
    "headers": {
      "items": {
        "type": "string"
      },
      "title": "Headers",
      "type": "array"
    },
    "rows": {
      "items": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Rows",
      "type": "array"
    },
    "header_rows": {
      "items": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Header Rows",
      "type": "array"
    },
    "orientation": {
      "default": "unknown",
      "enum": [
        "compounds_as_rows",
        "properties_as_rows",
        "matrix",
        "unknown"
      ],
      "title": "Orientation",
      "type": "string"
    },
    "subject_compound_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject Compound Label"
    },
    "scaffold_mol_id": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scaffold Mol Id"
    },
    "footnote_markers": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Footnote Markers",
      "type": "object"
    },
    "cell_details": {
      "description": "Sparse annotations only: row/column, optional section, mol_id, markers, spans, bbox, status. Omit ordinary cells.",
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Cell Details",
      "type": "array"
    },
    "status": {
      "default": "ok",
      "enum": [
        "ok",
        "unclear",
        "not_a_table"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "headers",
    "rows",
    "footnote_markers",
    "cell_details"
  ],
  "title": "CompactTable",
  "type": "object"
}
