# 本机基础设施已部署在 /home/xq/projects/drugpaper-infra。
# 根目录 .env 已填入真实连接配置（不要提交）；本文件保留无密钥模板。
# 复制模板到其他环境时，将 <PASSWORD_URL_ENCODED> 替换为 URL 编码后的密码。
# 现有部署的真实连接值见 /home/xq/projects/drugpaper-infra/app.env。
# Agent 问答使用 GPT-6 Luna（Responses、中等思考）；视觉任务使用独立 VLM。
VLM_BASE_URL=http://10.154.24.54:3000/v1
VLM_MODEL=Qwen3.6-27B
VLM_API_KEY=
VLM_LIGHT_MODEL=${VLM_MODEL}
LLM_BASE_URL=https://api.102465.xyz/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# 同端点主模型3次可重试失败后切换，备用也最多3次。
LLM_FALLBACK_MODEL=gpt-5.6-terra
MODELS_CONFIG_PATH=config/models.yaml
# PostgreSQL 16，已启用 vector、pg_trgm，已创建 lg schema。
# 使用前需运行 uv run drugpaper db upgrade；留空则回落到本地 SQLite。
DATABASE_URL=postgresql+asyncpg://drugpaper:<PASSWORD_URL_ENCODED>@127.0.0.1:15432/drugpaper
# 复用已有 Redis；DB 10/11/12/13 为本工程分配，不影响原 DB 0/1/2。
REDIS_URL=redis://:<PASSWORD_URL_ENCODED>@127.0.0.1:16379/10
# 以下 Celery / cache 配置留给后续实现，当前尚未接入。
CELERY_BROKER_URL=redis://:<PASSWORD_URL_ENCODED>@127.0.0.1:16379/11
CELERY_RESULT_BACKEND=redis://:<PASSWORD_URL_ENCODED>@127.0.0.1:16379/12
CACHE_REDIS_URL=redis://:<PASSWORD_URL_ENCODED>@127.0.0.1:16379/13
DRUGPAPER_ENV=dev
# P2：MinerU 服务（legacy_mineru_merge），例如 http://host:8001；离线导入不需要
MINERU_URL=http://10.154.24.43:8001
MINERU_MAX_INFLIGHT=4
MINERU_TIMEOUT_S=1200
MINERU_POLL_INTERVAL_S=5
MINERU_SUBMIT_ATTEMPTS=6
MINERU_BACKOFF_S=2
MINERU_SUBMIT_TIMEOUT_S=60
MINERU_STATUS_TIMEOUT_S=30
MINERU_RESULT_TIMEOUT_S=120
# MolParser：仅识别整图用 true；服务端检测+识别用 false。
MOLPARSER_BASE_URL=http://10.154.24.43:8003
MOLPARSER_TIMEOUT_S=60
MOLPARSER_REC_ONLY=true
# 当前 LocalFsBlobStore 的持久化目录；同机 API / Worker 使用相同路径。
BLOB_ROOT=/home/xq/projects/drugpaper-infra/shared/blobs
RUNS_DIR=/home/xq/projects/drugpaper-infra/shared/runs
# MinIO 服务已部署，私有 bucket 已创建；S3 BlobStore 适配器尚未实现。
# 填写 S3_* 不会自动切换当前 LocalFsBlobStore。
S3_ENDPOINT_URL=http://127.0.0.1:19000
S3_BUCKET=drugpaper
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# 集成测试用（可选）；未设置时使用嵌入式 pgserver
TEST_DATABASE_URL=

# P3 系统 Skill 目录、热加载；管理员 reload 令牌为空时拒绝该接口。
SKILLS_ROOT=./skills
SKILLS_WATCH_ENABLED=true
SKILLS_ADMIN_TOKEN=

# 分子检测：应用多 Worker 用 remote；专用检测 Worker 从本地权重推理。
YOLO_BACKEND=local
# YOLO_MODEL_PATH 未配置时返回 E_MODEL_NOT_READY；权重更换后需重启检测 Worker。
YOLO_MODEL_PATH=/home/xq/source/paper/checkpoints/moldet_v2_yolo11n_640_general.pt
YOLO_DEVICE=cpu
YOLO_BASE_URL=http://127.0.0.1:8010
YOLO_SERVICE_TOKEN=
YOLO_CONF=0.15
YOLO_HIGH_RECALL_CONF=0.08
YOLO_IOU=0.15
YOLO_IMGSZ=640
YOLO_PADDING_RATIO=0.05
YOLO_MAX_DETECTIONS=256
YOLO_QUEUE_SIZE=16
YOLO_MAX_JOBS_PER_USER=2
YOLO_QUEUE_TIMEOUT_S=30
YOLO_TIMEOUT_S=120
YOLO_CACHE_SIZE=64
YOLO_MAX_PIXELS=16000000
YOLO_MAX_IMAGE_BYTES=12000000

# P4：外部 MolParser 权重更新时修改版本以使识别缓存失效
MOLPARSER_MODEL_VERSION=default

# P6: optional platform OPSIN JSON service (base URL includes /ws or /opsin).
# Empty means unavailable; do not silently use a public service for private papers.
OPSIN_BASE_URL=
OPSIN_TIMEOUT_S=20
OPSIN_MODEL_VERSION=default

# 单图 FigureAgent：受控自主工具调用（false 可回到固定流程作对照）
FIGURE_EXPLORATION_ENABLED=true
FIGURE_EXPLORATION_MAX_TURNS=64
FIGURE_EXPLORATION_MAX_TOOL_CALLS=80
FIGURE_EXPLORATION_MAX_EXTRACTIONS=3
FIGURE_EXPLORATION_TIMEOUT_S=1800

# 单图 Agent 原图/整页/局部放大共用查看预算
FIGURE_EXPLORATION_MAX_VISUAL_READS=8
FIGURE_EXPLORATION_PREVIEW_BATCH_SIZE=4
FIGURE_EXPLORATION_MAX_PREVIEW_BATCHES=2
FIGURE_EXPLORATION_MAX_CONTEXT_IMAGES=12
FIGURE_EXPLORATION_MAX_REQUEST_BYTES=24000000
