{
  "name": "drugpaper-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "dev:offline": "node scripts/offline.mjs",
    "format": "prettier --write src tests scripts vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests scripts vite.config.ts playwright.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test:http": "node scripts/http-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@rdkit/rdkit": "^2026.9.2",
    "katex": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.10.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
